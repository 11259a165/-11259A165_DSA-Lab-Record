// Program 12: Implementation of Bubble, Selection and Heap Sorts


#include <stdio.h>

void bubble(int a[], int n)
{
int i, j, t;
for (i = 0; i < n - 1; i++)
for (j = 0; j < n - i - 1; j++)
if (a[j] > a[j + 1])
{
t = a[j];
a[j] = a[j + 1];
a[j + 1] = t;
}
}
void selection(int a[], int n)
{
int i, j, min, t;
for (i = 0; i < n - 1; i++)
{
min = i;
for (j = i + 1; j < n; j++)
if (a[j] < a[min])
min = j;
t = a[i];
a[i] = a[min];
a[min] = t;
}
}
void heapify(int a[], int n, int i)
{
int largest = i, l = 2 * i + 1;
int r = 2 * i + 2, t;
if (l < n && a[l] > a[largest])
largest = l;
if (r < n && a[r] > a[largest])
largest = r;
if (largest != i)
{
t = a[i];
a[i] = a[largest];
a[largest] = t;
heapify(a, n, largest);
}
}
void heap(int a[], int n)
{
int i, t;
for (i = n / 2 - 1; i >= 0; i--)
heapify(a, n, i);
for (i = n - 1; i > 0; i--)
{
t = a[0];
a[0] = a[i];
a[i] = t;
heapify(a, i, 0);
}
}
void display(int a[], int n)
{
int i;
for (i = 0; i < n; i++)
printf("%d ", a[i]);
printf("\n");
}
int main()
{
int a[100], b[100], s[100], h[100];
int n, i;
printf("Enter number of elements: ");
scanf("%d", &n);
printf("Enter elements: ");
for (i = 0; i < n; i++)
{
scanf("%d", &a[i]);
b[i] = s[i] = h[i] = a[i];
}
bubble(b, n);
selection(s, n);
heap(h, n);
printf("Bubble Sort: ");
display(b, n);
printf("Selection Sort: ");
display(s, n);
printf("Heap Sort: ");
display(h, n);
return 0;
}
