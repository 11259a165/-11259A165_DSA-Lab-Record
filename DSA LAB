// Program 14 : Implementation of Basic Array Operations


#include <stdio.h>

int main() {
int a[100], n, i, pos, value, choice;
printf("Enter number of elements: ");
scanf("%d", &n);
printf("Enter array elements: ");
for (i = 0; i < n; i++)
scanf("%d", &a[i]);
printf("\n1. Insertion\n2. Deletion\n3. Traversal\n");
printf("Enter your choice: ");
scanf("%d", &choice);
if (choice == 1) {
printf("Enter position and value: ");
scanf("%d%d", &pos, &value);

if (pos < 1 || pos > n + 1 || n >= 100) {
printf("Invalid position or full array");
} else {
for (i = n; i >= pos; i--)
a[i] = a[i - 1];
a[pos - 1] = value;
n++;
}
} else if (choice == 2) {
printf("Enter position to delete: ");
scanf("%d", &pos);
if (pos < 1 || pos > n) {
printf("Invalid position");
} else {
for (i = pos - 1; i < n - 1; i++)
a[i] = a[i + 1];
n--;
}
} else if (choice != 3) {
printf("Invalid choice");
return 0;
}
if (choice >= 1 && choice <= 3) {
printf("Array elements: ");
for (i = 0; i < n; i++)
printf("%d ", a[i]);
}
return 0;
}

