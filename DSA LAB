{
int i, pos = 0;
if (n == 0) {
printf("Queue is empty!\n");
return;
}
/* Find the element with highest priority */
for (i = 1; i < n; i++) {
if (pq[i].priority < pq[pos].priority) {
pos = i;
}
}
printf("Deleted element: %d\n", pq[pos].data);
/* Shift remaining elements */
for (i = pos; i < n - 1; i++) {
pq[i] = pq[i + 1];
  }
n--;
printf("Element deleted successfully!\n");
}
